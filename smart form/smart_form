REPORT zvar_sf_majorpro.

*----------------------------------------------------------------------*
* DATA DECLARATIONS
*----------------------------------------------------------------------*
DATA: wa_but000  TYPE but000,
      it_kna1    TYPE ZVAR_TT_SF,  " Your SE11 Table Type
      lv_fm_name TYPE rs38l_fnam.

*----------------------------------------------------------------------*
* SELECTION SCREEN
*----------------------------------------------------------------------*
PARAMETERS: p_partnr TYPE but000-partner.

START-OF-SELECTION.

* 1. Add leading zeros (e.g., convert '100' to '0000000100')
  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING
      input  = p_partnr
    IMPORTING
      output = p_partnr.

* 2. Fetch Business Partner Data (The Header)
  SELECT SINGLE partner bu_sort1 namcountry persnumber
    FROM but000
    INTO CORRESPONDING FIELDS OF wa_but000
    WHERE partner = p_partnr.

  IF sy-subrc <> 0.
    MESSAGE 'Business Partner not found in BUT000' TYPE 'I'.
    EXIT.
  ENDIF.

* 3. Get the dynamic Function Module name of your Smart Form
  CALL FUNCTION 'SSF_FUNCTION_MODULE_NAME'
    EXPORTING
      formname           = 'ZVAR_SF_MP'
    IMPORTING
      fm_name            = lv_fm_name
    EXCEPTIONS
      no_form            = 1
      no_function_module = 2
      OTHERS             = 3.

  IF sy-subrc <> 0.
    WRITE: 'Error: Smart Form ZVAR_SF_MP not found or not active'.
    EXIT.
  ENDIF.

* 4. Call the Smart Form
* We pass WA_BUT000 (Exporting) and IT_KNA1 (Tables)
  CALL FUNCTION lv_fm_name
    EXPORTING
*      user_settings    = 'X'
      wa_but000        = wa_but000
    TABLES
      it_kna1          = it_kna1
    EXCEPTIONS
      formatting_error = 1
      internal_error   = 2
      send_error       = 3
      user_canceled    = 4
      OTHERS           = 5.

  IF sy-subrc <> 0.
    WRITE: 'Error occurred while generating the Smart Form'.
  ENDIF.
